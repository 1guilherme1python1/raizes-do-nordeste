            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{adminEmail}}\",\"senha\":\"{{adminPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.expect(pm.response.code).to.eql(200));",
              "if(pm.response.code<300)pm.environment.set(\"adminToken\",pm.response.json().accessToken);if(pm.response.code<300)pm.environment.set(\"adminId\",pm.response.json().usuario.id);"
