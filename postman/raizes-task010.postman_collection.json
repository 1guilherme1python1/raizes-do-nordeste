{
  "info": {
    "name": "Raízes do Nordeste — TASK-010",
    "description": "Execução sequencial com dados sintéticos; configurar credenciais administrativas temporárias no ambiente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get(\"runId\")) { pm.environment.set(\"runId\", Date.now().toString(36) + Math.random().toString(36).slice(2, 8)); }"
        ]
      }
    }
  ],
